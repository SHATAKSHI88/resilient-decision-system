PORT=5000
NODE_ENV=development
# Required for submitting applications. Empty = API runs without a database (no saving)
MONGODB_URI=mongodb://127.0.0.1:27017/workflow_decision_platform
CLIENT_ORIGIN=http://localhost:5173
# Phase 9: automatic retry worker (polls MongoDB; no Redis/queue). Retry policy itself is stored in MongoDB: PUT /api/retries/config
RETRY_WORKER_ENABLED=true
RETRY_POLL_INTERVAL_MS=5000
RETRY_BATCH_SIZE=10
# A running retry that has not finished after this long is considered interrupted (app crashed) and is rescheduled
RETRY_LOCK_MS=120000
